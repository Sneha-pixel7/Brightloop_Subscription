# Copy to .env (optional - docker-compose has safe development defaults).
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

POSTGRES_DB=brightloop
POSTGRES_USER=brightloop
POSTGRES_PASSWORD=change-me
# POSTGRES_HOST / POSTGRES_PORT are set to the `db` service by docker-compose.yml

# Password-reset emails print to the web container log by default.
# For real email, switch to SMTP and add EMAIL_HOST, EMAIL_PORT, EMAIL_HOST_USER, EMAIL_HOST_PASSWORD.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Brightloop <no-reply@brightloop.local>
